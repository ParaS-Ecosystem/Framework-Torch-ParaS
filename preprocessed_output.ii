    template <typename T>
    struct minimum {

        constexpr T operator()(const T& a, const T& b) const {
            return (a < b) ? a : b;
        }
    };

    template <typename T>
    struct maximum {

        constexpr T operator()(const T& a, const T& b) const {
            return (a > b) ? a : b;
        }
    };

